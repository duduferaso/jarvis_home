<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Paleta: fundo #06080A, superfície #101A1E, ciano #22E5FF, texto #E8F6F8, texto fraco #9FB8BE -->

    <style name="JarvisBase" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:colorAccent">#22E5FF</item>
        <item name="android:colorPrimary">#06080A</item>
        <item name="android:colorPrimaryDark">#000000</item>
        <item name="android:colorControlNormal">#6E8E95</item>
        <item name="android:colorControlActivated">#22E5FF</item>
        <item name="android:colorControlHighlight">#3322E5FF</item>
        <item name="android:colorButtonNormal">#0D161A</item>
        <item name="android:textColorPrimary">#E8F6F8</item>
        <item name="android:textColorSecondary">#9FB8BE</item>
        <item name="android:textColorHint">#5E7A80</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:buttonStyle">@style/JarvisButton</item>
        <item name="android:alertDialogTheme">@style/JarvisDialog</item>
        <item name="android:datePickerDialogTheme">@style/JarvisPicker</item>
        <item name="android:timePickerDialogTheme">@style/JarvisPicker</item>
    </style>

    <!-- Telas com barra de status (configurações, agenda, treino). -->
    <style name="JarvisTheme" parent="JarvisBase">
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <!-- Tela cheia (rosto, calibração, treinos de voz). -->
    <style name="JarvisTheme.Fullscreen" parent="JarvisBase">
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="JarvisButton" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@drawable/btn_jarvis</item>
        <item name="android:textColor">#22E5FF</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:paddingLeft">18dp</item>
        <item name="android:paddingRight">18dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="JarvisDialog" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="android:colorAccent">#22E5FF</item>
        <item name="android:colorControlActivated">#22E5FF</item>
        <item name="android:textColorPrimary">#E8F6F8</item>
        <item name="android:textColorSecondary">#C5DCE0</item>
        <item name="android:textColor">#E8F6F8</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:buttonBarButtonStyle">@style/JarvisDialogButton</item>
    </style>

    <style name="JarvisDialogButton" parent="@android:style/Widget.Material.Button.Borderless.Colored">
        <item name="android:textColor">#22E5FF</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="JarvisPicker" parent="@android:style/Theme.Material.Dialog">
        <item name="android:colorAccent">#22E5FF</item>
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
