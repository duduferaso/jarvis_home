<?xml version="1.0" encoding="utf-8"?>
<!-- Fundo das janelas de diálogo: escuro, com borda ciano discreta (a MIUI pintava de cinza claro). -->
<inset xmlns:android="http://schemas.android.com/apk/res/android" android:inset="16dp">
    <shape android:shape="rectangle">
        <corners android:radius="18dp" />
        <solid android:color="#101A1E" />
        <stroke android:width="1dp" android:color="#5522E5FF" />
    </shape>
</inset>
