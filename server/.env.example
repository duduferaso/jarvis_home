# ---- Home Assistant ----
# IP do servidor Debian na sua rede (o HA em Docker normalmente usa network_mode: host)
HA_URL=http://192.168.1.10:8123
# Token de longa duração de um usuário DEDICADO e SEM privilégio de administrador
# (Perfil do usuário "jarvis" no HA > Segurança > Tokens de acesso de longa duração)
HA_TOKEN=cole_o_token_aqui
# Opcional: id da pipeline "Jarvis" (vazio = pipeline preferida do HA)
HA_PIPELINE_ID=

# ---- Terminais autorizados ----
# nome:token  (gere cada token com: openssl rand -hex 24)
# Para revogar um terminal, remova-o daqui e reinicie o container.
JARVIS_TERMINALS=redmi10:troque_por_um_token_aleatorio_de_48_caracteres

# ---- Ajustes ----
JARVIS_PORT=8765
JARVIS_CONVERSATION_TTL=300
JARVIS_MAX_UTTERANCE_SECONDS=15
JARVIS_RUN_TIMEOUT_SECONDS=60
# false = não grava o texto falado nos logs (padrão de privacidade)
JARVIS_LOG_TRANSCRIPTS=false

# ---- Modelos de voz (lidos pelo docker compose) ----
WHISPER_MODEL=small-int8
PIPER_VOICE=pt_BR-faber-medium
